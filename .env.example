# Copy to .env and fill in. NEVER commit .env.
#
# CANONICAL DEV PLACEHOLDER: `dev-secret` is the single value used by
# every committed default (backend/app/config.py, alembic.ini, the test
# conftest, CI, README examples). Copy-pasted dev/test commands work
# out of the box with it. For anything the tailnet can reach, replace
# BOTH password lines below (they are the only secrets here).

# --- Postgres ---
# REAL DEPLOYMENT: strong random value (postgres applies it only on first init)
POSTGRES_USER=budget
POSTGRES_PASSWORD=dev-secret
POSTGRES_DB=budget

# --- API ---
# REAL DEPLOYMENT: generate with: openssl rand -hex 32  (>= 32 bytes)
BUDGET_JWT_SECRET=dev-secret
# Set production for deployed instances; validates secrets at startup.
BUDGET_ENVIRONMENT=development
# Published deployment: matching immutable tag for API and web.
# BUDGET_IMAGE_TAG=sha-<full-commit-sha>

# One-time household bootstrap, format: user:passwo…ame] per member,
# comma-separated. Applied via: docker compose exec api python -m app.seed
# Clear this after seeding — don't leave passwords sitting in .env.
BUDGET_SEED_USERS=

# --- Tailscale (only for --profile tailscale) ---
TS_HOSTNAME=budget
# Ephemeral auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
